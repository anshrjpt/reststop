# Copy this file to .env and fill in values from
# Supabase dashboard → Project Settings → API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Secret: server only. Never put this in frontend code or commit it.
SUPABASE_SERVICE_KEY=your-service-role-key

# Public: optional, enables live map updates (Supabase Realtime) in the browser.
SUPABASE_ANON_KEY=your-anon-key

PORT=8000
